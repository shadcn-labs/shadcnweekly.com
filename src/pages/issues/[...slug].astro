---
import { mdxComponents } from "@/components/mdx";
import ArchiveSponsorSection from "@/components/archive-sponsor-section.astro";
import ArchiveTogetherWith from "@/components/archive-together-with.astro";
import { IssueReader } from "@/components/issue-reader";
import { IssueCopyPage } from "@/components/issue-copy-page";
import Layout from "@/layouts/site.astro";
import { ArrowLeftIcon } from "lucide-react";
import { getCollection, render } from "astro:content";
import { ROUTES } from "@/constants/routes";
import { LINKS } from "@/constants/links";
import { SITE } from "@/constants/site";
import { OG_IMAGE_HEIGHT, OG_IMAGE_TYPE, OG_IMAGE_WIDTH } from "@/lib/og";
import { SAMPLE_SPONSOR } from "@/lib/sponsor-preview";
import { breadcrumbJsonLd, issueJsonLd } from "@/seo/json-ld";
import JsonLd from "@/seo/json-ld.astro";

export const prerender = true;

export const getStaticPaths = async () => {
  const archive = await getCollection("archive");
  const issues = archive.toSorted((a, b) => a.data.issue - b.data.issue);
  return issues.map((issue, index) => ({
    params: { slug: issue.id },
    props: {
      issue,
      next: issues[index + 1],
      previous: issues[index - 1],
    },
  }));
};

const { issue, next, previous } = Astro.props;
const adjacent = [
  ...(previous ? [{ entry: previous, label: "← Previous", side: "start" }] : []),
  ...(next ? [{ entry: next, label: "Next →", side: "end" }] : []),
];
const { Content, headings } = await render(issue);
const imageSlug = issue.id.split("/").map(encodeURIComponent).join("/");
const sections = headings.flatMap(({ depth, slug, text }) =>
  depth === 2 || depth === 3 ? [{ depth, id: slug, label: text }] : []
);
const summary = issue.data.summary ?? {
  bullets: issue.data.highlights,
  explainer: `This issue is a curated guide to ${issue.data.highlights.join(", ")}. Open any section to learn what changed and follow the original source.`,
  overview: issue.data.description,
};

const formattedDate = issue.data.date.toLocaleDateString("en-US", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Layout
  title={issue.data.title}
  description={issue.data.description}
  image={`/og/issues/${imageSlug}.png`}
  imageAlt={`${issue.data.title} — Shadcn Weekly Issue #${issue.data.issue}`}
  imageWidth={OG_IMAGE_WIDTH}
  imageHeight={OG_IMAGE_HEIGHT}
  imageType={OG_IMAGE_TYPE}
  ogType="article"
>
  <JsonLd
    slot="head"
    data={issueJsonLd({
      date: issue.data.date,
      description: issue.data.description,
      image: `/og/issues/${imageSlug}.png`,
      number: issue.data.issue,
      path: `${ROUTES.ISSUES}/${issue.id}`,
      title: issue.data.title,
    })}
  />
  <JsonLd
    slot="head"
    data={breadcrumbJsonLd([
      { name: "Issues", path: ROUTES.ISSUES },
      { name: issue.data.title, path: `${ROUTES.ISSUES}/${issue.id}` },
    ])}
  />

  <div class="flex flex-1 flex-col items-center py-16">
    <div class="reading-container flex flex-col gap-8">
      <div class="flex items-center justify-between gap-4">
        <a
          href={ROUTES.ISSUES}
          class="inline-flex items-center gap-2 text-sm text-muted-foreground transition-colors hover:text-foreground"
        >
          <ArrowLeftIcon className="size-4" />
          Back to archive
        </a>
        <IssueCopyPage
          client:load
          githubUrl={`${LINKS.GITHUB}/blob/main/${issue.filePath}`}
          markdownUrl={`${ROUTES.ISSUES}/${issue.id}.md`}
          pageUrl={new URL(`${ROUTES.ISSUES}/${issue.id}`, SITE.URL).href}
        />
      </div>

      <header class="flex flex-col items-center gap-6 text-center">
        <p class="text-sm text-muted-foreground">
          <span>Issue #{issue.data.issue}</span>
          <span aria-hidden="true" class="mx-1">·</span>
          <time datetime={issue.data.date.toISOString()}>{formattedDate}</time>
        </p>

        <h1
          class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl"
        >
          {issue.data.title}
        </h1>

        <hr class="w-full border-border" />

        {
          issue.data.sponsor ? (
            <ArchiveTogetherWith website={issue.data.sponsor} />
          ) : null
        }
      </header>

      <article id="issue-article" class="typeset typeset-issue text-left">
        <Content components={mdxComponents} />
        <div data-reader-ignore>
          <p>
            Have a link you want to share? Send me an email at{" "}
            <a href={`mailto:${LINKS.EMAIL}`}>{LINKS.EMAIL}</a>
          </p>
          <p class="text-muted-foreground not-typeset">
            All submissions are appreciated.
          </p>
          <p class="text-muted-foreground">👋 See you next week!</p>
        </div>
      </article>
      {
        adjacent.length > 0 ? (
          <nav
            aria-label="Issue navigation"
            class="grid gap-4 sm:grid-cols-2"
          >
            {adjacent.map(({ entry, label, side }) => (
              <a
                href={`${ROUTES.ISSUES}/${entry.id}`}
                rel={side === "start" ? "prev" : "next"}
                class:list={[
                  "flex flex-col gap-1 rounded-lg border border-border bg-card p-4 transition-colors hover:bg-accent/50",
                  side === "end" && "text-right sm:col-start-2",
                ]}
              >
                <span class="text-sm text-muted-foreground">{label}</span>
                <span class="text-base font-medium text-balance">
                  #{entry.data.issue} · {entry.data.title}
                </span>
              </a>
            ))}
          </nav>
        ) : null
      }
  {
    sections.length > 0 ? (
      <IssueReader
        articleId="issue-article"
        client:load
        sections={sections}
        summary={summary}
        title={issue.data.title}
      />
    ) : null
  }
    </div>
  </div>

  <template id="sponsor-sample">
    <ArchiveSponsorSection {...SAMPLE_SPONSOR} />
  </template>

  <script>
    import { SPONSOR_PREVIEW_PARAM } from "@/lib/sponsor-preview";

    const placements =
      new URLSearchParams(location.search)
        .get(SPONSOR_PREVIEW_PARAM)
        ?.split(",") ?? [];
    const article = document.querySelector("#issue-article");

    const insertSample = (root: Element) => {
      const template = document.querySelector<HTMLTemplateElement>(
        "#sponsor-sample"
      );
      const sample = template?.content.firstElementChild?.cloneNode(true);
      if (!(sample instanceof HTMLElement)) {
        return;
      }
      const headings = [...root.querySelectorAll(":scope > h2")];
      const projects = headings.findIndex((heading) =>
        heading.textContent?.includes("Projects, Packages & Tools")
      );
      const next =
        (projects === -1 ? undefined : headings[projects + 1]) ??
        root.querySelector(":scope > [data-reader-ignore]");
      next?.before(sample, document.createElement("hr"));
      return sample;
    };

    const PADDING = 12;

    const contentRect = (element: Element) => {
      const range = document.createRange();
      range.selectNodeContents(element);
      return range.getBoundingClientRect();
    };

    const highlight = (target: HTMLElement, label: string) => {
      const frame = document.createElement("div");
      frame.setAttribute("aria-hidden", "true");
      frame.className =
        "pointer-events-none absolute z-30 rounded-xl ring-2 ring-primary ring-offset-0";
      const tag = document.createElement("span");
      tag.className =
        "absolute -top-3 left-3 rounded-full bg-primary px-2 py-0.5 text-xs font-medium text-primary-foreground";
      tag.textContent = label;
      frame.append(tag);
      document.body.append(frame);
      return () => {
        const rect = contentRect(target);
        Object.assign(frame.style, {
          height: `${rect.height + PADDING * 2}px`,
          left: `${rect.left + window.scrollX - PADDING}px`,
          top: `${rect.top + window.scrollY - PADDING}px`,
          width: `${rect.width + PADDING * 2}px`,
        });
      };
    };

    if (article && placements.length > 0) {
      const [primary, secondary] = article.querySelectorAll<HTMLElement>(
        "[data-sponsor-section]"
      );
      const together = document.querySelector<HTMLElement>(
        "[data-sponsor-together]"
      );
      const targets = [
        ...(placements.includes("primary")
          ? [
              { label: "1st Sponsor", target: together },
              { label: "1st Sponsor", target: primary },
            ]
          : []),
        ...(placements.includes("secondary")
          ? [
              {
                label: "2nd Sponsor",
                target: secondary ?? insertSample(article),
              },
            ]
          : []),
      ];
      const highlighted = targets.flatMap(({ label, target }) =>
        target instanceof HTMLElement ? [{ label, target }] : []
      );
      const updates = highlighted.map(({ label, target }) =>
        highlight(target, label)
      );
      const position = () => {
        for (const update of updates) {
          update();
        }
      };
      position();
      const observer = new ResizeObserver(position);
      observer.observe(document.body);
      for (const { target } of highlighted) {
        observer.observe(target);
      }
      highlighted
        .find(({ target }) => target.matches("[data-sponsor-section]"))
        ?.target.scrollIntoView({ block: "center" });
    }
  </script>

</Layout>
