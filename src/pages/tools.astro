---
import { getCollection } from "astro:content";
import Layout from "@/layouts/site.astro";
import ToolCard from "@/components/tool-card.astro";
import { ToolsToolbar } from "@/components/tools-toolbar";
import { Input } from "@/components/ui/input";
import {
  Empty,
  EmptyDescription,
  EmptyHeader,
  EmptyTitle,
} from "@/components/ui/empty";
import { ArrowLeftIcon, SearchIcon, XIcon } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import { SITE } from "@/constants/site";
import { ROUTES } from "@/constants/routes";
import { TOOL_CATEGORIES } from "@/constants/tools";
import { breadcrumbJsonLd } from "@/seo/json-ld";
import JsonLd from "@/seo/json-ld.astro";

// Rendered on demand so the URL filters (?q=&category=) and the saved view
// cookie produce the final markup on the server: no flash of the unfiltered
// grid before the script runs.
export const prerender = false;

const TOOLS_VIEW_COOKIE = "tools-view";

const toolsCollection = await getCollection("tools");
const tools = toolsCollection.toSorted(
  (a, b) => b.data.issue - a.data.issue || a.data.title.localeCompare(b.data.title),
);

const query = Astro.url.searchParams.get("q")?.trim() ?? "";
const requestedCategory = Astro.url.searchParams.get("category") ?? "";
const category = tools.some((tool) => tool.data.category === requestedCategory)
  ? requestedCategory
  : "";
// List is the default; only an explicit "grid" cookie switches it.
const view =
  Astro.cookies.get(TOOLS_VIEW_COOKIE)?.value === "grid" ? "grid" : "list";

// Same matching as the page script below: search on title + description.
const needle = query.toLowerCase();
const matchesQuery = (tool: (typeof tools)[number]) =>
  !needle ||
  `${tool.data.title} ${tool.data.description}`.toLowerCase().includes(needle);

const counts: Record<string, number> = { "": 0 };
for (const tool of tools) {
  if (matchesQuery(tool)) {
    counts[""] += 1;
    counts[tool.data.category] = (counts[tool.data.category] ?? 0) + 1;
  }
}
const visibleTools = new Set(
  tools.filter(
    (tool) =>
      matchesQuery(tool) && (!category || tool.data.category === category),
  ),
);

const filters = [
  { count: tools.length, label: "All", value: "" },
  ...TOOL_CATEGORIES.flatMap((name) => {
    const count = tools.filter((tool) => tool.data.category === name).length;
    return count > 0 ? [{ count, label: name, value: name }] : [];
  }),
];
---

<Layout
  title="Tools"
  description={`Hand-picked shadcn tools, libraries, and resources curated by ${SITE.NAME}. Discover the best tools for your next project.`}
>
  <JsonLd
    slot="head"
    data={breadcrumbJsonLd([{ name: "Tools", path: ROUTES.TOOLS }])}
  />
  <div class="flex flex-1 flex-col items-center py-16">
    <div class="reading-container flex flex-col gap-8">
      <div>
        <a
          href={ROUTES.HOME}
          class="inline-flex text-sm items-center gap-2 text-muted-foreground transition-colors hover:text-foreground"
        >
          <ArrowLeftIcon className="size-4" />
          Back to home
        </a>
      </div>

      <div class="flex flex-col gap-3">
        <h1 class="text-3xl font-semibold tracking-tight">Tools</h1>
        <p class="text-base text-muted-foreground">
          Hand-picked tools, libraries, and resources from the shadcn ecosystem.
          Updated weekly.
        </p>
      </div>

      <div class="flex flex-col gap-6">
        <search class="flex flex-col gap-3">
          <div class="relative">
            <SearchIcon
              className="pointer-events-none absolute top-1/2 left-3.5 size-4 -translate-y-1/2 text-muted-foreground"
              aria-hidden="true"
            />
            <Input
              type="search"
              name="q"
              placeholder="Search tools"
              aria-label="Search tools"
              autoComplete="off"
              className="h-9 pl-9 pr-9 [&::-webkit-search-cancel-button]:appearance-none"
              defaultValue={query}
              data-tools-search
            />
            <button
              type="button"
              aria-label="Clear search"
              class="absolute top-1/2 right-1.5 flex size-6 -translate-y-1/2 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
              hidden={!query}
              data-tools-clear
            >
              <XIcon className="size-3.5" aria-hidden="true" />
            </button>
          </div>
          <ToolsToolbar
            client:load
            categories={filters}
            initialCategory={category}
            initialCounts={counts}
            initialView={view}
          />
        </search>

        <p class="sr-only" aria-live="polite" data-tools-status>
          {visibleTools.size === 1 ? "1 tool shown" : `${visibleTools.size} tools shown`}
        </p>

        <div
          class="grid gap-4 sm:grid-cols-2"
          data-tools-grid
          data-view={view}
          data-category-filter={category}
          hidden={visibleTools.size === 0}
        >
          {
            tools.map((tool) => (
              <ToolCard
                title={tool.data.title}
                description={tool.data.description}
                category={tool.data.category}
                screenshot={tool.data.image}
                primary={tool.data.url}
                hidden={!visibleTools.has(tool)}
              />
            ))
          }
        </div>

        <Empty
          className="border border-border"
          hidden={visibleTools.size > 0}
          data-tools-empty
        >
          <EmptyHeader>
            <EmptyTitle className="text-base">No tools found</EmptyTitle>
            <EmptyDescription>
              Try a different search or category.
            </EmptyDescription>
          </EmptyHeader>
          <button
            type="button"
            class={buttonVariants({ size: "sm", variant: "outline" })}
            data-tools-reset
          >
            Clear filters
          </button>
        </Empty>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { TOOLS_EVENT } from "@/lib/tools-events";

  const dispatch = (name: string, detail: unknown) => {
    window.dispatchEvent(new CustomEvent(name, { detail }));
  };

  const search = document.querySelector<HTMLInputElement>(
    "[data-tools-search]",
  );
  const grid = document.querySelector<HTMLElement>("[data-tools-grid]");
  const empty = document.querySelector<HTMLElement>("[data-tools-empty]");
  const status = document.querySelector<HTMLElement>("[data-tools-status]");

  if (search && grid && empty && status) {
    const cards = [
      ...grid.querySelectorAll<HTMLElement>("[data-tool-card]"),
    ];
    const knownCategories = new Set([
      "",
      ...cards.map((card) => card.dataset.category ?? ""),
    ]);

    // The server already rendered this state; read it back instead of
    // recomputing from the URL so nothing changes on load.
    let category = grid.dataset.categoryFilter ?? "";
    let view = grid.dataset.view === "grid" ? "grid" : "list";

    const apply = () => {
      const query = search.value.trim().toLowerCase();
      const counts = new Map<string, number>();

      let visible = 0;
      for (const card of cards) {
        const cardCategory = card.dataset.category ?? "";
        const matches = !query || Boolean(card.dataset.search?.includes(query));
        if (matches) {
          counts.set("", (counts.get("") ?? 0) + 1);
          counts.set(cardCategory, (counts.get(cardCategory) ?? 0) + 1);
        }
        const show = matches && (!category || cardCategory === category);
        card.hidden = !show;
        visible += Number(show);
      }

      grid.hidden = visible === 0;
      empty.hidden = visible > 0;
      status.textContent =
        visible === 1 ? "1 tool shown" : `${visible} tools shown`;

      const url = new URL(window.location.href);
      if (query) {
        url.searchParams.set("q", search.value.trim());
      } else {
        url.searchParams.delete("q");
      }
      if (category) {
        url.searchParams.set("category", category);
      } else {
        url.searchParams.delete("category");
      }
      window.history.replaceState(window.history.state, "", url);

      dispatch(TOOLS_EVENT.CATEGORY, category);
      dispatch(TOOLS_EVENT.COUNTS, Object.fromEntries(counts));
    };

    const applyView = (next: string) => {
      view = next;
      grid.dataset.view = next;
      // Cookie, not localStorage, so the server renders the saved view.
      // oxlint-disable-next-line unicorn/no-document-cookie -- Cookie Store API is missing in Firefox; one static cookie needs no library.
      document.cookie = `tools-view=${next}; path=/tools; max-age=31536000; samesite=lax`;
      dispatch(TOOLS_EVENT.VIEW, view);
    };

    const clear = document.querySelector<HTMLButtonElement>(
      "[data-tools-clear]",
    );
    const syncClear = () => {
      if (clear) {
        clear.hidden = !search.value;
      }
    };
    search.addEventListener("input", () => {
      syncClear();
      apply();
    });
    clear?.addEventListener("click", () => {
      search.value = "";
      syncClear();
      apply();
      search.focus();
    });
    document
      .querySelector("[data-tools-reset]")
      ?.addEventListener("click", () => {
        search.value = "";
        category = "";
        syncClear();
        apply();
        search.focus();
      });
    window.addEventListener(TOOLS_EVENT.CATEGORY_SET, (event) => {
      const next = (event as CustomEvent<string>).detail;
      if (knownCategories.has(next)) {
        category = next;
        apply();
      }
    });
    window.addEventListener(TOOLS_EVENT.VIEW_SET, (event) => {
      const next = (event as CustomEvent<string>).detail;
      if (next === "list" || next === "grid") {
        applyView(next);
      }
    });
    window.addEventListener(TOOLS_EVENT.SYNC, () => {
      apply();
      dispatch(TOOLS_EVENT.VIEW, view);
    });

  }
</script>

<style is:global>
  [data-tools-grid][data-view="list"] {
    grid-template-columns: minmax(0, 1fr);
  }

  [data-tools-grid][data-view="list"] > [data-tool-card] {
    flex-direction: row;
    align-items: stretch;
  }

  [data-tools-grid][data-view="list"] [data-tool-card-media] {
    align-self: stretch;
    aspect-ratio: auto;
    flex-shrink: 0;
    width: 7rem;
  }

  [data-tools-grid][data-view="list"] [data-tool-card-body] {
    min-width: 0;
  }

  [data-tools-grid][data-view="list"] [data-tool-card-body] p {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  @media (min-width: 40rem) {
    [data-tools-grid][data-view="list"] [data-tool-card-media] {
      width: 11rem;
    }
  }
</style>
