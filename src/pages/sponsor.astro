---
import { ArrowLeftIcon } from "lucide-react";

import { SponsorModal } from "@/components/sponsor-modal";
import type { SponsorOffer } from "@/components/sponsor-modal";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import {
  Card,
  CardContent,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { ROUTES } from "@/constants/routes";
import { SITE } from "@/constants/site";
import { SPONSOR_PLACEMENTS } from "@/constants/sponsor";
import { availableWeeks } from "@/constants/sponsor-bookings";
import Layout from "@/layouts/site.astro";

// Bookings change only with a deploy, so build-time availability is fresh.
export const prerender = true;

const offers: SponsorOffer[] = SPONSOR_PLACEMENTS.map((placement) => ({
  description: placement.description,
  id: placement.id,
  issues: placement.issues,
  price: placement.price,
  tag: placement.tag,
  title: placement.title,
  weeks: availableWeeks(placement.placement),
}));
---

<Layout
  title="Sponsor"
  description={`Sponsor ${SITE.NAME} and reach shadcn developers, designers, and builders every week.`}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", item: SITE.URL, name: "Home", position: 1 },
        {
          "@type": "ListItem",
          item: `${SITE.URL}${ROUTES.SPONSOR}`,
          name: "Sponsor",
          position: 2,
        },
      ],
    })}
  />
  <div class="flex flex-1 flex-col items-center py-16">
    <div class="flex max-w-2xl flex-col gap-8">
      <div>
        <a
          href={ROUTES.HOME}
          class="inline-flex text-sm items-center gap-2 text-muted-foreground transition-colors hover:text-foreground"
        >
          <ArrowLeftIcon className="size-4" />
          Back to home
        </a>
      </div>

      <div class="flex flex-col gap-3">
        <h1 class="text-3xl font-semibold tracking-tight">Sponsor</h1>
        <p class="text-base text-muted-foreground">
          Put your product, library, or service in front of developers who
          actually build with shadcn/ui every day.
        </p>
      </div>

      <div class="flex flex-col gap-8">
        <div class="flex flex-col gap-3">
          <h2 class="text-xl font-semibold">Why sponsor {SITE.NAME}?</h2>
          <div class="flex flex-col gap-3 leading-relaxed text-muted-foreground">
            <p>
              {SITE.NAME} goes out every Monday. It's a curated newsletter for
              the shadcn ecosystem — new releases, community projects,
              tutorials, and tools.
            </p>
            <p>
              This isn't a generic dev blast with 100k subscribers who never
              open it. The audience here is builders — people who read the
              changelog, try new component libraries on weekends, and care about
              clean UI code. If your product speaks to that crowd, this is the
              place to be.
            </p>
            <p>
              Sponsorships are limited and the pricing is fair. No programmatic
              ad slots, no "sponsored by" walls. Every booking is reviewed
              before it runs.
            </p>
          </div>
        </div>

        <div class="flex flex-col gap-4">
          <h2 class="text-xl font-semibold">Placements</h2>

          <div class="grid gap-4 sm:grid-cols-2">
            {
              offers.map((offer) => (
                <Card className="rounded-lg border border-border ring-0">
                  <CardHeader>
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
                      <CardTitle>{offer.title}</CardTitle>
                      {offer.tag === "Most Performing" && (
                        <Badge variant="warning">{offer.tag}</Badge>
                      )}
                      {offer.tag === "Best Value" && (
                        <Badge variant="success">{offer.tag}</Badge>
                      )}
                    </div>
                  </CardHeader>
                  <CardContent>
                    <p class="text-sm leading-relaxed text-muted-foreground">
                      {offer.description}
                    </p>
                  </CardContent>
                  <CardFooter className="mt-auto">
                    <SponsorModal
                      client:load
                      offers={offers}
                      defaultOffer={offer.id}
                    >
                      <span class={buttonVariants({ variant: "default" })}>
                        Book for ${offer.price}
                      </span>
                    </SponsorModal>
                  </CardFooter>
                </Card>
              ))
            }
          </div>
          <p class="text-xs text-muted-foreground/60">
            All rates in USD. Payments processed securely by{" "}
            <a
              href="https://dodopayments.com"
              class="link"
              target="_blank"
              rel="noopener noreferrer"
            >
              Dodo Payments
            </a>
            .
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>
