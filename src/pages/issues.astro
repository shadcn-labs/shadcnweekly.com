---
import Layout from "@/layouts/site.astro";
import { ArrowLeftIcon } from "lucide-react";
import { getCollection } from "astro:content";
import { ROUTES } from "@/constants/routes";
import { breadcrumbJsonLd } from "@/seo/json-ld";
import JsonLd from "@/seo/json-ld.astro";

const issues = await getCollection("archive");
const sortedIssues = issues.toSorted((a, b) => b.data.issue - a.data.issue);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    day: "numeric",
    month: "long",
    timeZone: "UTC",
    year: "numeric",
  });
---

<Layout
  title="Issues Archive"
  description="Browse every issue of Shadcn Weekly—curated shadcn news, tutorials, projects, and tools."
>
  <JsonLd
    slot="head"
    data={breadcrumbJsonLd([{ name: "Issues", path: ROUTES.ISSUES }])}
  />

  <div class="flex flex-1 flex-col items-center py-16">
    <div class="reading-container flex flex-col gap-8">
      <div>
        <a
          href="/"
          class="inline-flex items-center gap-2 text-sm text-muted-foreground transition-colors hover:text-foreground"
        >
          <ArrowLeftIcon className="size-4" />
          Back to home
        </a>
      </div>

      <div class="flex flex-col gap-3">
        <h1 class="text-3xl font-semibold tracking-tight">
          Newsletter Archive
        </h1>
        <p class="text-base text-muted-foreground">
          Every issue of Shadcn Weekly in one place. Never miss a roundup.
        </p>
      </div>

      <div class="flex flex-col gap-3">
        {
          sortedIssues.map((issue, index) => (
            <a
              href={`${ROUTES.ISSUES}/${issue.id}`}
              class="group flex flex-col gap-2 rounded-lg border border-border bg-card p-4 transition-colors hover:bg-accent/50"
            >
              <div class="flex items-center justify-between gap-3">
                {/* Both variants are h-5 so every card's top row is the same height. */}
                {index === 0 ? (
                  <span class="inline-flex h-5 items-center gap-1.5 rounded-full bg-muted px-2 text-xs leading-none font-semibold text-foreground ring-1 ring-border ring-inset">
                    <span class="relative flex size-1.5">
                      <span class="absolute inline-flex size-full animate-ping rounded-full bg-primary opacity-75" />
                      <span class="relative inline-flex size-1.5 rounded-full bg-primary" />
                    </span>
                    Latest
                  </span>
                ) : (
                  <span class="inline-flex h-5 items-center text-sm leading-none font-semibold text-primary">
                    Issue #{issue.data.issue}
                  </span>
                )}
                <time
                  datetime={issue.data.date.toISOString()}
                  class="shrink-0 text-xs text-muted-foreground/60"
                >
                  {formatDate(issue.data.date)}
                </time>
              </div>
              <h2 class="text-base font-semibold leading-snug group-hover:underline">
                {issue.data.title}
              </h2>
              <p class="text-sm leading-relaxed text-muted-foreground">
                {issue.data.description}
              </p>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</Layout>
