---
import { ArrowLeftIcon } from "lucide-react";

import { ContactForm } from "@/components/contact-form";
import { LINKS } from "@/constants/links";
import { ROUTES } from "@/constants/routes";
import { SITE } from "@/constants/site";
import Layout from "@/layouts/site.astro";
import { breadcrumbJsonLd } from "@/seo/json-ld";
import JsonLd from "@/seo/json-ld.astro";
---

<Layout
  title="Contact"
  description={`Get in touch with ${SITE.NAME} — send a message or reach us by email and Discord.`}
>
  <JsonLd
    slot="head"
    data={breadcrumbJsonLd([{ name: "Contact", path: ROUTES.CONTACT }])}
  />
  <div class="flex flex-1 flex-col items-center py-16">
    <div class="flex w-full max-w-2xl flex-col gap-6">
      <div>
        <a
          href={ROUTES.HOME}
          class="inline-flex text-sm items-center gap-2 text-muted-foreground transition-colors hover:text-foreground"
        >
          <ArrowLeftIcon className="size-4" />
          Back to home
        </a>
      </div>

      <div class="flex flex-col gap-2">
        <h1 class="text-3xl font-semibold tracking-tight">Contact</h1>
        <p class="text-base text-muted-foreground">
          Send a message using the form, or reach out directly.
        </p>
      </div>

      <ContactForm client:load />

      <p class="text-base text-muted-foreground">
        Or email <a
          href={`mailto:${LINKS.EMAIL}`}
          class="text-foreground underline underline-offset-4">{LINKS.EMAIL}</a
        > or <a
          href={LINKS.DISCORD}
          target="_blank"
          rel="noopener noreferrer"
          class="text-foreground underline underline-offset-4"
          >join our Discord</a
        >.
      </p>
    </div>
  </div>
</Layout>
