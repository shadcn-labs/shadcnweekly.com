---
import { getCollection } from "astro:content";
import { markdownResponse } from "@dualmark/core";
import Layout from "@/layouts/site.astro";
import ColorBends from "@/components/color-bends";
import ReaderLogos from "@/components/reader-logos.astro";
import SubscribeSection from "@/components/subscribe-section.astro";
import Testimonials from "@/components/testimonials.astro";
import { ArrowRightIcon } from "lucide-react";
import { SITE } from "@/constants/site";
import { ROUTES } from "@/constants/routes";
import { homeMarkdown } from "@/lib/agent-markdown";
import { prefersMarkdown } from "@/lib/content-negotiation";
import { getSubscriberCount } from "@/lib/kit";

// Rendered on demand so Accept negotiation runs at request time. A prerendered
// homepage would be served straight from the CDN and skip the middleware.
export const prerender = false;

const [issues, subscriberCount] = await Promise.all([
  getCollection("archive"),
  getSubscriberCount(),
]);
const [latestIssue] = issues.toSorted((a, b) => b.data.issue - a.data.issue);

if (prefersMarkdown(Astro.request.headers.get("accept"))) {
  // oxlint-disable-next-line unicorn/prefer-module -- Astro frontmatter may return a Response.
  return markdownResponse(
    homeMarkdown(
      latestIssue
        ? {
            description: latestIssue.data.description,
            id: latestIssue.id,
            issue: latestIssue.data.issue,
            title: latestIssue.data.title,
          }
        : undefined
    ),
    { cacheControl: "public, max-age=3600, s-maxage=86400" }
  );
}
---

<Layout
  title={`${SITE.NAME} - ${SITE.DESCRIPTION.SHORT}`}
  description={`${SITE.DESCRIPTION.LONG} Stay up-to-date with what's happening in the shadcn ecosystem.`}
  fullWidth
>
  <link
    slot="head"
    rel="alternate"
    type="text/markdown"
    href="/index.md"
    title={`${SITE.NAME} Markdown`}
  />

  <div class="relative isolate flex flex-1 flex-col">
    <div class="pointer-events-none fixed inset-0 -z-10" aria-hidden="true">
      <ColorBends
        client:load
        colors={["#174bff", "#4668ff", "#133ac0"]}
        rotation={90}
        speed={0.15}
        scale={1}
        frequency={1}
        warpStrength={1}
        mouseInfluence={0.35}
        parallax={0.2}
        noise={0.03}
        iterations={1}
        intensity={1}
        bandWidth={6}
        transparent
      />
    </div>

    <section
      class="page-container flex flex-col items-center justify-center gap-3 py-16 text-center sm:py-24"
    >
      <div class="flex flex-col items-center gap-3">
        {
          latestIssue ? (
            <a
              href={`${ROUTES.ISSUES}/${latestIssue.id}`}
              class="group mb-3 inline-flex max-w-fit items-center gap-2 rounded-full border border-border bg-background py-1 pl-1 pr-3 text-xs font-medium text-muted-foreground transition-colors hover:border-foreground/20 hover:bg-muted/50 hover:text-foreground"
            >
              <span class="relative inline-flex items-center gap-1.5 rounded-full bg-muted px-2.5 py-0.5 text-xs font-semibold text-foreground ring-1 ring-inset ring-border">
                <span class="relative flex size-1.5">
                  <span class="absolute inline-flex size-full animate-ping rounded-full bg-primary opacity-75" />
                  <span class="relative inline-flex size-1.5 rounded-full bg-primary" />
                </span>
                New
              </span>
              <span class="truncate">Issue #{latestIssue.data.issue} is out</span>
              <ArrowRightIcon className="size-3.5 shrink-0 text-muted-foreground transition-transform group-hover:translate-x-0.5 group-hover:text-foreground" />
            </a>
          ) : null
        }

        <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">
          Stay up-to-date on shadcn
        </h1>

        <p class="max-w-xl text-base leading-relaxed text-muted-foreground">
          The shadcn/ui newsletter for Tailwind CSS and React developers. Get the
          best components, tutorials, projects and tools every Monday.
        </p>
      </div>

      <SubscribeSection formClass="mt-5" subscriberCount={subscriberCount} />
    </section>

    <section
      aria-labelledby="inside-heading"
      class="page-container py-12 sm:py-16"
    >
      <div class="mx-auto flex max-w-2xl flex-col gap-4">
        <h2
          id="inside-heading"
          class="text-2xl font-semibold tracking-tight text-balance"
        >
          What's inside every issue
        </h2>

        <p class="leading-relaxed text-muted-foreground">
          Shadcn Weekly is a free weekly newsletter covering the shadcn/ui
          ecosystem. Every Monday we round up the most useful news, tutorials,
          component libraries, registries, blocks and developer tools for people
          building interfaces with shadcn/ui, Tailwind CSS, React and Base UI. It
          is the easiest way to keep up with what shipped, what changed and what
          is worth trying, without scrolling through X or GitHub all week.
        </p>

        <ul
          class="flex list-disc flex-col gap-1.5 pl-5 leading-relaxed text-muted-foreground"
        >
          <li>Top stories and releases from the shadcn/ui ecosystem</li>
          <li>Hand-picked articles, tutorials and migration guides</li>
          <li>
            New projects, packages and tools, each added to the tools directory
          </li>
          <li>Every issue archived on the site, so you can catch up any time</li>
        </ul>

        <p class="leading-relaxed text-muted-foreground">
          Each issue is curated by hand: top stories and releases, articles and
          migration guides, new projects and packages, and adjacent work worth
          knowing about. Every project we feature is added to the tools
          directory, so you can search the archive by category later.
        </p>

        <p class="leading-relaxed text-muted-foreground">
          Shadcn Weekly is for frontend engineers, designers and founders who
          build with shadcn/ui and Tailwind CSS. Subscribing is free, takes one
          email a week, and you can unsubscribe at any time. If you are new to
          the ecosystem, start with the latest issue; if you are looking for a
          specific tool, search the tools directory.
        </p>

        <p class="leading-relaxed text-muted-foreground">
          Published every Monday by <a
            href={SITE.ORG.URL}
            target="_blank"
            rel="noopener noreferrer"
            class="link">{SITE.ORG.NAME}</a
          > and curated by <a
            href={SITE.AUTHOR.URL}
            target="_blank"
            rel="noopener noreferrer"
            class="link">{SITE.AUTHOR.NAME}</a
          >. Read the <a href={ROUTES.ISSUES} class="link">issue archive</a>,
          browse the <a href={ROUTES.TOOLS} class="link">tools directory</a>, or
          learn <a href={ROUTES.ABOUT} class="link">how issues are curated</a>.
        </p>
      </div>
    </section>

    <ReaderLogos />
    <Testimonials />
  </div>
</Layout>
