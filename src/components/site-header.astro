---
import GithubLink from "@/components/github-link.astro";
import { Logo } from "@/components/logo";
import ThemeToggle from "@/components/theme-toggle.astro";
import { ROUTES } from "@/constants/routes";
import { SITE } from "@/constants/site";

const NAV_LINKS = [
  { href: ROUTES.TOOLS, label: "Tools" },
  { href: ROUTES.ISSUES, label: "Archive" },
  { href: ROUTES.SPONSOR, label: "Sponsor" },
];

const pathname = Astro.url.pathname.replace(/\/$/u, "") || "/";
const isCurrent = (href: string) =>
  pathname === href || pathname.startsWith(`${href}/`);

// Hamburger bars: 1.5px tall, 4.5px apart, so ±6px meets in the middle.
const bar =
  "h-[1.5px] w-full rounded-full bg-current transition duration-300 ease-[cubic-bezier(0.32,0.72,0,1)]";
---

<header class="group/header relative z-40 px-6 py-4" data-site-header>
  <div class="flex items-center justify-between">
    <a
      href={ROUTES.HOME}
      class="flex items-center gap-2 transition-opacity hover:opacity-80"
    >
      <Logo className="size-5" />
      <span class="text-lg font-semibold tracking-tight">{SITE.NAME}</span>
    </a>

    <div class="hidden items-center gap-4 sm:flex">
      <nav class="flex items-center gap-6" aria-label="Main">
        {
          NAV_LINKS.map((link) => (
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? "page" : undefined}
              class="text-sm text-muted-foreground transition-colors hover:text-foreground aria-[current=page]:text-foreground"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <span class="h-4 w-px bg-border" aria-hidden="true"></span>
      <GithubLink />
      <span class="h-4 w-px bg-border" aria-hidden="true"></span>
      <ThemeToggle />
    </div>

    <button
      type="button"
      class="-mr-2 inline-flex size-9 items-center justify-center rounded-md transition-colors hover:bg-muted sm:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Open menu"
      data-menu-toggle
    >
      <span class="flex w-4.5 flex-col gap-[4.5px]" aria-hidden="true">
        <span
          class:list={[
            bar,
            "group-data-open/header:translate-y-[6px] group-data-open/header:rotate-45",
          ]}
        ></span>
        <span class:list={[bar, "group-data-open/header:opacity-0"]}></span>
        <span
          class:list={[
            bar,
            "group-data-open/header:-translate-y-[6px] group-data-open/header:-rotate-45",
          ]}
        ></span>
      </span>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="pointer-events-none invisible absolute inset-x-3 top-full -translate-y-2 scale-[0.98] rounded-2xl border bg-background/95 p-3 opacity-0 shadow-lg backdrop-blur-md transition-[opacity,translate,scale,visibility] duration-200 ease-out group-data-open/header:pointer-events-auto group-data-open/header:visible group-data-open/header:translate-y-0 group-data-open/header:scale-100 group-data-open/header:opacity-100 sm:hidden"
    inert
    data-menu-panel
  >
    <nav class="flex flex-col" aria-label="Mobile">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            aria-current={isCurrent(link.href) ? "page" : undefined}
            class="rounded-lg px-3 py-2.5 text-lg text-foreground/80 transition-colors hover:bg-muted hover:text-foreground aria-[current=page]:font-medium aria-[current=page]:text-foreground"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="mt-2 flex items-center justify-between border-t px-1 pt-3">
      <GithubLink class="size-9" iconClass="size-5" />
      <ThemeToggle size="md" />
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const toggle = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = header?.querySelector<HTMLElement>("[data-menu-panel]");

  if (header && toggle && panel) {
    const setOpen = (open: boolean) => {
      header.toggleAttribute("data-open", open);
      // `inert` keeps the closed panel's links out of the tab order.
      panel.toggleAttribute("inert", !open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    };

    toggle.addEventListener("click", () => {
      setOpen(!Object.hasOwn(header.dataset, "open"));
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && Object.hasOwn(header.dataset, "open")) {
        setOpen(false);
        toggle.focus();
      }
    });
    document.addEventListener("click", (event) => {
      if (
        Object.hasOwn(header.dataset, "open") &&
        !header.contains(event.target as Node)
      ) {
        setOpen(false);
      }
    });
    window
      .matchMedia("(min-width: 640px)")
      .addEventListener("change", (event) => {
        if (event.matches) {
          setOpen(false);
        }
      });
  }

  // Theme: persist the choice; the inline script in layouts/main.astro
  // applies it before first paint on later visits.
  const themeButtons = document.querySelectorAll<HTMLButtonElement>(
    "[data-theme-value]"
  );
  const syncPressed = () => {
    const dark = document.documentElement.classList.contains("dark");
    for (const button of themeButtons) {
      button.setAttribute(
        "aria-pressed",
        String((button.dataset.themeValue === "dark") === dark)
      );
    }
  };
  for (const button of themeButtons) {
    button.addEventListener("click", () => {
      const theme = button.dataset.themeValue === "dark" ? "dark" : "light";
      localStorage.setItem("theme", theme);
      document.documentElement.classList.toggle("dark", theme === "dark");
      syncPressed();
    });
  }
  syncPressed();
</script>
