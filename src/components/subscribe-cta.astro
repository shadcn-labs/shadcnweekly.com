---
import { FlipNumber } from "@/components/flip-number";
import { Logo } from "@/components/logo";
import { SubscribeForm } from "@/components/subscribe-form";
import { cn } from "@/lib/utils";
import { getSubscriberCount } from "@/lib/kit";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const subscriberCount = await getSubscriberCount();
---

<!-- Two-panel subscription CTA embedded in issue #1. -->
<section
  aria-label="Subscribe to Shadcn Weekly"
  class={cn(
    "relative w-full rounded-3xl border border-border/60 bg-muted p-1.5 text-center",
    className,
  )}
>
  <div
    class="absolute -top-6 left-1/2 -translate-x-1/2 rounded-2xl bg-background px-1.5 pb-1"
  >
    <div
      class="primary-gradient flex size-12 items-center justify-center rounded-xl shadow-md"
    >
      <Logo className="size-7" />
    </div>
  </div>

  <div
    class="flex flex-col items-center gap-3 rounded-[1.25rem] bg-background px-5 pt-10 pb-7 shadow-xs ring-1 ring-border/60 sm:px-10"
  >
    <h2
      class="text-xl font-semibold leading-snug tracking-tight text-balance sm:text-2xl"
    >
      {
        subscriberCount === null ? (
          "Join developers keeping up with shadcn."
        ) : (
          <>
            Join <span class="sr-only">{subscriberCount}</span>
            <FlipNumber client:load value={subscriberCount} />
            &#8288;+ developers keeping up with shadcn.
          </>
        )
      }
    </h2>
    <p
      class="max-w-md text-base leading-relaxed text-muted-foreground text-balance"
    >
      A weekly newsletter with the most interesting shadcn{" "}
      <span class="desc-text">News</span>,{" "}
      <span class="desc-text">Tutorials</span>,{" "}
      <span class="desc-text">Projects</span>, and{" "}
      <span class="desc-text">Tools</span>.
    </p>
  </div>

  <div class="flex flex-col items-center gap-3 px-2 pt-5 pb-5 sm:px-8">
    <p class="text-sm text-muted-foreground">
      <span class="font-medium text-foreground">100% free</span> &middot; Delivered
      every Monday
    </p>
    <div class="w-full max-w-md">
      <SubscribeForm client:load />
    </div>
  </div>
</section>
