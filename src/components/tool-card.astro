---
import { withUtm } from "@/lib/utm";
import { ExternalLink, ImageIcon } from "lucide-react";

interface Props {
  title: string;
  description: string;
  category: string;
  screenshot?: string;
  primary: string;
  /** Server-rendered filter state; the page script toggles it afterwards. */
  hidden?: boolean;
}

const { title, description, category, screenshot, primary, hidden } =
  Astro.props;
const href = withUtm(primary, {
  campaign: "tools",
  content: "tool-card",
  medium: "referral",
});
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  data-tool-card
  hidden={hidden}
  data-category={category}
  data-search={`${title} ${description}`.toLowerCase()}
  class="group flex flex-col overflow-hidden rounded-lg border border-border bg-card transition-colors hover:bg-accent/50"
>
  <div
    class="relative flex aspect-video items-center justify-center overflow-hidden bg-muted"
    data-tool-card-media
  >
    <ImageIcon
      className="size-6 text-muted-foreground/40"
      aria-hidden="true"
    />
    {
      screenshot && (
        <img
          src={screenshot}
          alt={title}
          class="absolute inset-0 h-full w-full bg-muted object-cover opacity-0 transition-transform duration-300 group-hover:scale-105"
          loading="lazy"
        />
      )
    }
  </div>
  <div class="flex flex-1 flex-col gap-2 p-4" data-tool-card-body>
    <div class="flex items-start justify-between gap-2">
      <h3 class="text-base font-semibold leading-tight">{title}</h3>
      <ExternalLink
        className="mt-0.5 size-3.5 shrink-0 text-muted-foreground opacity-0 transition-opacity group-hover:opacity-100"
      />
    </div>
    <p class="flex-1 text-sm leading-relaxed text-muted-foreground">
      {description}
    </p>
    <span class="text-xs text-muted-foreground">{category}</span>
  </div>
</a>

<script>
  for (const image of document.querySelectorAll<HTMLImageElement>(
    "[data-tool-card-media] img",
  )) {
    const updatePreview = () => {
      image.classList.toggle("opacity-0", !image.naturalWidth);
    };

    image.addEventListener("load", updatePreview);
    image.addEventListener("error", updatePreview);
    // Cached images may finish before the listeners are attached.
    if (image.complete) {
      updatePreview();
    }
  }
</script>
