---
import { Font } from "astro:assets";
import { SEO } from "astro-seo";
import Analytics from "@vercel/analytics/astro";
import { META_THEME_COLORS, SITE } from "@/constants/site";
import { ROUTES } from "@/constants/routes";
import {
  buildOgImagePath,
  OG_IMAGE_HEIGHT,
  OG_IMAGE_TYPE,
  OG_IMAGE_WIDTH,
} from "@/lib/og";
import { organizationJsonLd, websiteJsonLd } from "@/seo/json-ld";
import JsonLd from "@/seo/json-ld.astro";

const DEFAULT_HEADLINE = "Stay up-to-date on shadcn";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  canonical?: string;
  noindex?: boolean;
  nofollow?: boolean;
  ogType?: "website" | "article";
}

const {
  title = DEFAULT_HEADLINE,
  description = SITE.DESCRIPTION.LONG,
  image,
  imageAlt = `${SITE.NAME} - ${DEFAULT_HEADLINE}`,
  imageWidth = OG_IMAGE_WIDTH,
  imageHeight = OG_IMAGE_HEIGHT,
  imageType = OG_IMAGE_TYPE,
  canonical,
  noindex = false,
  nofollow = false,
  ogType = "website",
} = Astro.props;

const canonicalURL = canonical
  ? new URL(canonical, SITE.URL)
  : new URL(Astro.url.pathname, SITE.URL);

const isHome = Astro.url.pathname === ROUTES.HOME;
const pageTitle = isHome ? title : `${title} | ${SITE.NAME}`;

const ogImagePath =
  image ??
  buildOgImagePath({
    description,
    title: isHome ? DEFAULT_HEADLINE : title,
  });

const ogImageURL = new URL(ogImagePath, SITE.URL).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content={META_THEME_COLORS.light} />
<meta name="application-name" content={SITE.NAME} />
<meta name="apple-mobile-web-app-title" content={SITE.NAME} />
<meta name="author" content={SITE.AUTHOR.NAME} />
<meta name="keywords" content={SITE.KEYWORDS.join(", ")} />

<link rel="icon" type="image/svg+xml" href={ROUTES.FAVICON} />
<link rel="icon" type="image/png" sizes="96x96" href={ROUTES.FAVICON_PNG} />
<link rel="icon" sizes="32x32" href={ROUTES.FAVICON_ICO} />
<link rel="apple-touch-icon" sizes="180x180" href={ROUTES.APPLE_TOUCH_ICON} />
<link rel="manifest" href={ROUTES.MANIFEST} />
<link rel="author" href={SITE.AUTHOR.URL} />

<SEO
  title={pageTitle}
  description={description}
  canonical={canonicalURL.href}
  noindex={noindex}
  nofollow={nofollow}
  robotsExtras="max-snippet:-1, max-image-preview:large, max-video-preview:-1"
  openGraph={{
    basic: {
      title: pageTitle,
      type: ogType,
      image: ogImageURL,
      url: canonicalURL.href,
    },
    optional: {
      description,
      siteName: SITE.NAME,
      locale: SITE.LOCALE,
    },
    image: {
      alt: imageAlt,
      width: imageWidth,
      height: imageHeight,
      type: imageType,
    },
  }}
  twitter={{
    card: "summary_large_image",
    site: SITE.TWITTER,
    creator: SITE.AUTHOR.TWITTER,
    title: pageTitle,
    description,
    image: ogImageURL,
    imageAlt,
  }}
  extend={{
    link: [
      { rel: "sitemap", href: ROUTES.SITEMAP },
      {
        rel: "alternate",
        type: "text/plain",
        href: ROUTES.LLMS,
        title: `${SITE.NAME} for LLMs`,
      },
    ],
  }}
/>

<slot />

<Font cssVariable="--font-sans" preload />
<Analytics />

<JsonLd data={websiteJsonLd()} />
<JsonLd data={organizationJsonLd()} />
