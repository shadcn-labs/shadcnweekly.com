---
import { LinkTooltip } from "@/components/link-tooltip";
import { buttonVariants } from "@/components/ui/button";
import { LINKS } from "@/constants/links";
import {
  formatStars,
  formatStarsFull,
  getGithubStars,
} from "@/lib/github-stars";
import { cn } from "@/lib/utils";

interface Props {
  /** 36px button with a size-5 icon (mobile menu). */
  large?: boolean;
}

const { large = false } = Astro.props;
const stars = await getGithubStars();
const showStars = stars !== null && stars > 0;
// Text + icon when there's a count, square icon button otherwise.
const SIZES = {
  icon: { large: "icon-lg", normal: "icon" },
  text: { large: "lg", normal: "default" },
} as const;
const size = SIZES[showStars ? "text" : "icon"][large ? "large" : "normal"];
const label = showStars ? formatStarsFull(stars) : "Star on GitHub";
---

<LinkTooltip client:load label={label}>
<a
  href={LINKS.GITHUB}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={showStars
    ? `GitHub repository (${formatStarsFull(stars)})`
    : "GitHub repository"}
  class={cn(
    buttonVariants({ size, variant: "ghost" }),
    // 8px side padding keeps the visible gap to the dividers at ~16px.
    showStars && "px-2",
    "font-normal"
  )}
>
  {/* lucide-react 1.x ships no brand icons. */}
  <svg
    viewBox="0 0 24 24"
    class={large ? "size-5" : "size-4"}
    fill="currentColor"
    aria-hidden="true"
  >
    <path
      d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.7 1.6.2 2.9.1 3.2.8.8 1.3 1.9 1.3 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1.1.9 2.2v3.3c0 .3.1.7.8.6A12 12 0 0 0 12 .3"
    ></path>
  </svg>
  {
    showStars ? (
      <span class="text-sm tabular-nums" aria-hidden="true">
        {formatStars(stars)}
      </span>
    ) : null
  }
</a>
</LinkTooltip>
