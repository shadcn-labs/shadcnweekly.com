---
import { cn } from "@/lib/utils";

interface Props {
  class?: string;
  iconClass?: string;
}

const { class: className, iconClass = "size-[18px]" } = Astro.props;
---

{/* One button flips light/dark. The half-filled icon turns 180° with the root `dark` class, so it animates on every toggle and is correct on first paint. The header script wires clicks. */}
<button
  type="button"
  data-theme-toggle
  aria-label="Toggle theme"
  class={cn(
    "inline-flex size-8 items-center justify-center rounded-full text-muted-foreground transition-colors hover:text-foreground",
    className
  )}
>
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.25"
    aria-hidden="true"
    class={cn(
      "transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] motion-reduce:transition-none dark:rotate-180",
      iconClass
    )}
  >
    <circle cx="12" cy="12" r="9"></circle>
    <path d="M12 3a9 9 0 0 1 0 18Z" fill="currentColor" stroke="none"></path>
  </svg>
</button>
