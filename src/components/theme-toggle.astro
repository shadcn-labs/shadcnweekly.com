---
import { MoonIcon, SunIcon } from "lucide-react";

import { cn } from "@/lib/utils";

interface Props {
  size?: "sm" | "md";
}

const { size = "sm" } = Astro.props;
const button = cn(
  "inline-flex items-center justify-center rounded-full transition-colors",
  size === "sm" ? "size-7" : "size-8"
);
const icon = size === "sm" ? "size-3.5" : "size-4";
---

{/* Active state is driven by the root `dark` class, so it is right on first paint; the header script wires clicks. */}
<div
  class="inline-flex items-center rounded-full border p-0.5"
  role="group"
  aria-label="Theme"
>
  <button
    type="button"
    data-theme-value="light"
    aria-label="Light theme"
    class={cn(
      button,
      "bg-muted text-foreground dark:bg-transparent dark:text-muted-foreground dark:hover:text-foreground"
    )}
  >
    <SunIcon className={icon} />
  </button>
  <button
    type="button"
    data-theme-value="dark"
    aria-label="Dark theme"
    class={cn(
      button,
      "text-muted-foreground hover:text-foreground dark:bg-muted dark:text-foreground"
    )}
  >
    <MoonIcon className={icon} />
  </button>
</div>
