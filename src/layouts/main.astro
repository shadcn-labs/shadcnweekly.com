---
import Head from "@/components/head.astro";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  canonical?: string;
  noindex?: boolean;
  nofollow?: boolean;
  ogType?: "website" | "article";
}

const seoProps = Astro.props;
---

<html lang="en">
  <head>
    <Head {...seoProps} />
    <script is:inline>
      // Saved choice from the header toggle wins; otherwise follow the system.
      // Inline so the class is set before first paint (no flash).
      const saved = localStorage.getItem("theme");
      const dark =
        saved === "dark" ||
        (saved !== "light" &&
          window.matchMedia("(prefers-color-scheme: dark)").matches);
      document.documentElement.classList.toggle("dark", dark);
    </script>
  </head>
  <body class="antialiased flex flex-col min-h-svh">
    <slot />
  </body>
</html>
