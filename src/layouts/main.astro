---
import Head from "@/components/head.astro";
import { Toaster } from "@/components/ui/sonner";
import { META_THEME_COLORS } from "@/constants/site";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  canonical?: string;
  noindex?: boolean;
  nofollow?: boolean;
  ogType?: "website" | "article";
}

const seoProps = Astro.props;
---

<html lang="en">
  <head>
    <Head {...seoProps}>
      <slot name="head" />
    </Head>
    <script
      is:inline
      define:vars={{ themeColors: META_THEME_COLORS }}
    >
      const saved = localStorage.getItem("theme");
      const dark =
        saved === "dark" ||
        (saved !== "light" &&
          window.matchMedia("(prefers-color-scheme: dark)").matches);
      document.documentElement.classList.toggle("dark", dark);
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute("content", dark ? themeColors.dark : themeColors.light);
    </script>
  </head>
  <body class="antialiased flex flex-col min-h-svh">
    <slot />
    <Toaster client:idle position="bottom-center" />
    <script>
      import { captureAttribution } from "@/lib/attribution";

      captureAttribution();
    </script>
  </body>
</html>
