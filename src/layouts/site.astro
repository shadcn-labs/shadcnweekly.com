---
import MainLayout from "@/layouts/main.astro";
import SiteHeader from "@/components/site-header.astro";
import SiteFooter from "@/components/site-footer.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  canonical?: string;
  noindex?: boolean;
  nofollow?: boolean;
  ogType?: "website" | "article";
}

const seoProps = Astro.props;
---

<MainLayout {...seoProps}>
  <slot name="head" slot="head" />
  <SiteHeader />
  <main
    class="page-container relative flex min-h-[calc(100svh-var(--header-height))] flex-col"
  >
    <slot />
  </main>
  <SiteFooter />
</MainLayout>
